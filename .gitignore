# Generated tables: ignore everything by default, then track only the small
# aggregate CSVs that back the report's tables/figures so the notebook renders
# end-to-end on any machine (GPU or not). The large row-level prediction dumps
# and the per-seed sweep histories stay ignored (regenerable, ~MB each).
reports/tables/*.csv
!reports/tables/qwen3.5_*_dev.csv
!reports/tables/*_multiseed_macro_f1_bands.csv
!reports/tables/*_language_metrics.csv
!reports/tables/*_per_label_metrics.csv
!reports/tables/*_macro_f1.csv
!reports/tables/*_per_label_f1.csv
